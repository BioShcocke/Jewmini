  function heShowdown() {
    heStage = 'showdown';
    const pEval = evaluateBestSeven([...hePlayer, ...heBoard]);
    const oEval = evaluateBestSeven([...heOpp, ...heBoard]);
    const cmp = compareEval(pEval, oEval);
    let msg = '';
    if (cmp > 0) {
      balance += hePot;
      msg = `You win ${formatShillings(hePot)} with ${pEval.name} vs ${oEval.name}!`;
    } else if (cmp < 0) {
      msg = `Opponent wins ${formatShillings(hePot)} with ${oEval.name} vs ${pEval.name}.`;
    } else {
      const half = Math.floor(hePot / 2);
      balance += half;
      msg = `Split pot (${pEval.name})! You get ${formatShillings(half)}.`;
    }
    hePot = 0;
    document.getElementById('sr-he-status').textContent = msg;
    heUpdateUI(true);
  }

  function heAdvanceStage() {
    if (heStage === 'preflop') {
      heStage = 'flop';
      heBoard.push(heDeck.pop(), heDeck.pop(), heDeck.pop());
      document.getElementById('sr-he-status').textContent = 'Flop dealt! Check/Call, Raise +100 ₪, or Fold.';
    } else if (heStage === 'flop') {
      heStage = 'turn';
      heBoard.push(heDeck.pop());
      document.getElementById('sr-he-status').textContent = 'Turn card dealt! Make your move.';
    } else if (heStage === 'turn') {
      heStage = 'river';
      heBoard.push(heDeck.pop());
      document.getElementById('sr-he-status').textContent = 'River card dealt! Final betting round.';
    } else if (heStage === 'river') {
      heShowdown();
      return;
    }
    heUpdateUI(false);
  }

