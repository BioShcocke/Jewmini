    while (first.wild) first = unoDrawOne();
    unoDiscard = [first];
    unoActiveColor = first.color;
    unoActive = true;
    document.getElementById('sr-uno-status').textContent = `Round started! Match ${unoActiveColor.toUpperCase()} or ${first.value}.`;
